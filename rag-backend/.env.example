# AI Provider: openrouter | ollama | openai
AI_PROVIDER=openrouter

# OpenRouter (cloud, default provider - free tier available)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Ollama (local fallback, free, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI-compatible (any provider following OpenAI format)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Retrieval settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=1.5

# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
